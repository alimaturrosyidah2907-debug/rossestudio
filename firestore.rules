rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ---- Shared Security & Validation Primitives ----
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'alimaturrosyidah2907@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isOptionalString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isRequiredString(data, field, minLen, maxLen) {
      return field in data && data[field] is string && data[field].size() >= minLen && data[field].size() <= maxLen;
    }

    // ---- Entity Validation Helpers ----
    function isValidAdminMarker(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt'])
        && data.keys().hasOnly(['email', 'role', 'createdAt'])
        && isRequiredString(data, 'email', 3, 254)
        && data.role == 'admin'
        && data.createdAt is timestamp;
    }

    function isValidUserAccount(data) {
      return data.keys().hasAll(['name', 'email', 'role', 'updatedAt'])
        && data.keys().hasOnly(['name', 'email', 'role', 'updatedAt'])
        && isRequiredString(data, 'name', 1, 120)
        && isRequiredString(data, 'email', 3, 254)
        && data.role == 'admin'
        && data.updatedAt is timestamp;
    }

    function isValidHeroSetting(data) {
      return data.keys().hasAll(['updatedAt'])
        && data.keys().hasOnly(['headline', 'sub_headline', 'foto_profil', 'updatedAt'])
        && isOptionalString(data, 'headline', 300)
        && isOptionalString(data, 'sub_headline', 2000)
        && isOptionalString(data, 'foto_profil', 900000)
        && data.updatedAt is timestamp;
    }

    function isValidAboutSetting(data) {
      return data.keys().hasAll(['updatedAt'])
        && data.keys().hasOnly(['bio', 'trivia_unik', 'updatedAt'])
        && isOptionalString(data, 'bio', 8000)
        && isOptionalString(data, 'trivia_unik', 4000)
        && data.updatedAt is timestamp;
    }

    function isValidEducation(data) {
      return data.keys().hasAll(['institusi', 'jurusan', 'tahun_masuk', 'tahun_lulus', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['institusi', 'jurusan', 'tahun_masuk', 'tahun_lulus', 'deskripsi', 'createdAt', 'updatedAt'])
        && isRequiredString(data, 'institusi', 1, 200)
        && isRequiredString(data, 'jurusan', 1, 200)
        && isRequiredString(data, 'tahun_masuk', 1, 30)
        && isRequiredString(data, 'tahun_lulus', 1, 30)
        && isOptionalString(data, 'deskripsi', 2000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExperience(data) {
      return data.keys().hasAll(['kategori_pengalaman', 'posisi', 'institusi_tempat', 'durasi', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['kategori_pengalaman', 'posisi', 'institusi_tempat', 'durasi', 'deskripsi', 'createdAt', 'updatedAt'])
        && data.kategori_pengalaman in ['Organisasi', 'Profesional']
        && isRequiredString(data, 'posisi', 1, 200)
        && isRequiredString(data, 'institusi_tempat', 1, 200)
        && isRequiredString(data, 'durasi', 1, 80)
        && isOptionalString(data, 'deskripsi', 2000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAchievement(data) {
      return data.keys().hasAll(['judul_prestasi', 'penyelenggara', 'tahun', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['judul_prestasi', 'penyelenggara', 'tahun', 'deskripsi', 'createdAt', 'updatedAt'])
        && isRequiredString(data, 'judul_prestasi', 1, 250)
        && isRequiredString(data, 'penyelenggara', 1, 200)
        && isRequiredString(data, 'tahun', 1, 30)
        && isOptionalString(data, 'deskripsi', 2000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCertificate(data) {
      return data.keys().hasAll(['judul', 'penerbit', 'tahun', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['judul', 'penerbit', 'tahun', 'gambar_sertifikat', 'createdAt', 'updatedAt'])
        && isRequiredString(data, 'judul', 1, 250)
        && isRequiredString(data, 'penerbit', 1, 200)
        && isRequiredString(data, 'tahun', 1, 30)
        && isOptionalString(data, 'gambar_sertifikat', 900000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSkill(data) {
      return data.keys().hasAll(['nama_skill', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['nama_skill', 'logo_icon', 'createdAt', 'updatedAt'])
        && isRequiredString(data, 'nama_skill', 1, 120)
        && isOptionalString(data, 'logo_icon', 900000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExpertiseCategory(data) {
      return data.keys().hasAll(['title', 'tagline', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'tagline', 'cover_image', 'createdAt', 'updatedAt'])
        && isRequiredString(data, 'title', 1, 150)
        && isRequiredString(data, 'tagline', 1, 300)
        && isOptionalString(data, 'cover_image', 900000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPortfolioItem(data) {
      return data.keys().hasAll(['category_id', 'title', 'description', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['category_id', 'title', 'description', 'image', 'price_or_tech', 'link_url', 'createdAt', 'updatedAt'])
        && isValidId(data.category_id)
        && isRequiredString(data, 'title', 1, 200)
        && isRequiredString(data, 'description', 1, 4000)
        && isOptionalString(data, 'image', 900000)
        && isOptionalString(data, 'price_or_tech', 200)
        && isOptionalString(data, 'link_url', 500)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTestimonial(data) {
      return data.keys().hasAll(['nama_klien', 'peran', 'isi_review', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['nama_klien', 'peran', 'isi_review', 'foto_profil_opsional', 'createdAt', 'updatedAt'])
        && isRequiredString(data, 'nama_klien', 1, 150)
        && isRequiredString(data, 'peran', 1, 150)
        && isRequiredString(data, 'isi_review', 1, 2000)
        && isOptionalString(data, 'foto_profil_opsional', 900000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFaq(data) {
      return data.keys().hasAll(['pertanyaan', 'jawaban', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['pertanyaan', 'jawaban', 'createdAt', 'updatedAt'])
        && isRequiredString(data, 'pertanyaan', 1, 400)
        && isRequiredString(data, 'jawaban', 1, 4000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFooterContact(data) {
      return data.keys().hasAll(['updatedAt'])
        && data.keys().hasOnly([
          'alamat_teks', 'email', 'wa', 'ig', 'linkedin',
          'cv_file', 'maps_embed_iframe_link', 'teks_copyright_dinamis', 'updatedAt'
        ])
        && isOptionalString(data, 'alamat_teks', 500)
        && isOptionalString(data, 'email', 254)
        && isOptionalString(data, 'wa', 60)
        && isOptionalString(data, 'ig', 250)
        && isOptionalString(data, 'linkedin', 300)
        && isOptionalString(data, 'cv_file', 900000)
        && isOptionalString(data, 'maps_embed_iframe_link', 2000)
        && isOptionalString(data, 'teks_copyright_dinamis', 300)
        && data.updatedAt is timestamp;
    }

    function isValidSiteTheme(data) {
      return data.keys().hasAll(['active_theme_name', 'updatedAt'])
        && data.keys().hasOnly(['active_theme_name', 'updatedAt'])
        && data.active_theme_name in [
          'obsidian-crimson', 'midnight-navy', 'burgundy-wine', 'espresso-taupe', 'eucalyptus-porcelain', 'dusty-mauve'
        ]
        && data.updatedAt is timestamp;
    }

    function isValidContactMessage(data) {
      return data.keys().hasAll(['nama', 'email', 'subjek', 'pesan', 'createdAt'])
        && data.keys().hasOnly(['nama', 'email', 'subjek', 'pesan', 'createdAt'])
        && isRequiredString(data, 'nama', 1, 150)
        && isRequiredString(data, 'email', 3, 254)
        && isRequiredString(data, 'subjek', 1, 250)
        && isRequiredString(data, 'pesan', 1, 4000)
        && data.createdAt is timestamp;
    }

    // ---- Collection Rules ----
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isAdmin();
      allow list: if false;
      allow create: if isValidId(adminId) && isAdmin() && isValidAdminMarker(incoming()) && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(adminId) && isAdmin();
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isAdmin() && isValidUserAccount(incoming()) && incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isAdmin() && isValidUserAccount(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'role', 'updatedAt']);
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /hero_settings/{docId} {
      allow get: if isValidId(docId);
      allow list: if true;
      allow create: if isValidId(docId) && isAdmin() && isValidHeroSetting(incoming()) && incoming().updatedAt == request.time;
      allow update: if isValidId(docId) && isAdmin() && isValidHeroSetting(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['headline', 'sub_headline', 'foto_profil', 'updatedAt']);
      allow delete: if isValidId(docId) && isAdmin();
    }

    match /about_settings/{docId} {
      allow get: if isValidId(docId);
      allow list: if true;
      allow create: if isValidId(docId) && isAdmin() && isValidAboutSetting(incoming()) && incoming().updatedAt == request.time;
      allow update: if isValidId(docId) && isAdmin() && isValidAboutSetting(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['bio', 'trivia_unik', 'updatedAt']);
      allow delete: if isValidId(docId) && isAdmin();
    }

    match /educations/{eduId} {
      allow get: if isValidId(eduId);
      allow list: if true;
      allow create: if isValidId(eduId) && isAdmin() && isValidEducation(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(eduId) && isAdmin() && isValidEducation(incoming())
        && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['institusi', 'jurusan', 'tahun_masuk', 'tahun_lulus', 'deskripsi', 'updatedAt']);
      allow delete: if isValidId(eduId) && isAdmin();
    }

    match /experiences/{expId} {
      allow get: if isValidId(expId);
      allow list: if true;
      allow create: if isValidId(expId) && isAdmin() && isValidExperience(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(expId) && isAdmin() && isValidExperience(incoming())
        && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['kategori_pengalaman', 'posisi', 'institusi_tempat', 'durasi', 'deskripsi', 'updatedAt']);
      allow delete: if isValidId(expId) && isAdmin();
    }

    match /achievements/{achId} {
      allow get: if isValidId(achId);
      allow list: if true;
      allow create: if isValidId(achId) && isAdmin() && isValidAchievement(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(achId) && isAdmin() && isValidAchievement(incoming())
        && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['judul_prestasi', 'penyelenggara', 'tahun', 'deskripsi', 'updatedAt']);
      allow delete: if isValidId(achId) && isAdmin();
    }

    match /certificates/{certId} {
      allow get: if isValidId(certId);
      allow list: if true;
      allow create: if isValidId(certId) && isAdmin() && isValidCertificate(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(certId) && isAdmin() && isValidCertificate(incoming())
        && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['judul', 'penerbit', 'tahun', 'gambar_sertifikat', 'updatedAt']);
      allow delete: if isValidId(certId) && isAdmin();
    }

    match /skills/{skillId} {
      allow get: if isValidId(skillId);
      allow list: if true;
      allow create: if isValidId(skillId) && isAdmin() && isValidSkill(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(skillId) && isAdmin() && isValidSkill(incoming())
        && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['nama_skill', 'logo_icon', 'updatedAt']);
      allow delete: if isValidId(skillId) && isAdmin();
    }

    match /expertise_categories/{catId} {
      allow get: if isValidId(catId);
      allow list: if true;
      allow create: if isValidId(catId) && isAdmin() && isValidExpertiseCategory(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(catId) && isAdmin() && isValidExpertiseCategory(incoming())
        && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'tagline', 'cover_image', 'updatedAt']);
      allow delete: if isValidId(catId) && isAdmin();
    }

    match /portfolio_items/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if true;
      allow create: if isValidId(itemId) && isAdmin() && isValidPortfolioItem(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/expertise_categories/$(incoming().category_id));
      allow update: if isValidId(itemId) && isAdmin() && isValidPortfolioItem(incoming())
        && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/expertise_categories/$(incoming().category_id))
        && incoming().diff(existing()).affectedKeys().hasOnly(['category_id', 'title', 'description', 'image', 'price_or_tech', 'link_url', 'updatedAt']);
      allow delete: if isValidId(itemId) && isAdmin();
    }

    match /testimonials/{testiId} {
      allow get: if isValidId(testiId);
      allow list: if true;
      allow create: if isValidId(testiId) && isAdmin() && isValidTestimonial(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(testiId) && isAdmin() && isValidTestimonial(incoming())
        && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['nama_klien', 'peran', 'isi_review', 'foto_profil_opsional', 'updatedAt']);
      allow delete: if isValidId(testiId) && isAdmin();
    }

    match /faqs/{faqId} {
      allow get: if isValidId(faqId);
      allow list: if true;
      allow create: if isValidId(faqId) && isAdmin() && isValidFaq(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(faqId) && isAdmin() && isValidFaq(incoming())
        && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['pertanyaan', 'jawaban', 'updatedAt']);
      allow delete: if isValidId(faqId) && isAdmin();
    }

    match /footer_contacts/{docId} {
      allow get: if isValidId(docId);
      allow list: if true;
      allow create: if isValidId(docId) && isAdmin() && isValidFooterContact(incoming()) && incoming().updatedAt == request.time;
      allow update: if isValidId(docId) && isAdmin() && isValidFooterContact(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'alamat_teks', 'email', 'wa', 'ig', 'linkedin',
          'cv_file', 'maps_embed_iframe_link', 'teks_copyright_dinamis', 'updatedAt'
        ]);
      allow delete: if isValidId(docId) && isAdmin();
    }

    match /site_themes/{docId} {
      allow get: if isValidId(docId);
      allow list: if true;
      allow create: if isValidId(docId) && isAdmin() && isValidSiteTheme(incoming()) && incoming().updatedAt == request.time;
      allow update: if isValidId(docId) && isAdmin() && isValidSiteTheme(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['active_theme_name', 'updatedAt']);
      allow delete: if isValidId(docId) && isAdmin();
    }

    match /contact_messages/{msgId} {
      allow get: if isValidId(msgId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(msgId) && isValidContactMessage(incoming()) && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(msgId) && isAdmin();
    }
  }
}
